# ---- Core ----
# Postgres (Supabase in production). Use the pooled URL for DATABASE_URL and the direct URL for migrations.
DATABASE_URL="postgresql://hm:hm@localhost:5432/household_money"
DIRECT_URL="postgresql://hm:hm@localhost:5432/household_money"
# Public URL of the app (used for invite links, WebAuthn RP ID, Gmail redirect URI)
APP_URL="http://localhost:3000"
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Set to "true" to allow seeding/logging into the demo household (never in production with real data)
DEMO_MODE="true"

# ---- Email (invites, reports). Leave RESEND_API_KEY empty to log emails to the server console. ----
RESEND_API_KEY=""
EMAIL_FROM="Household Money <money@example.com>"

# ---- Plaid (Stage 5) ----
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# ---- SnapTrade Personal (Stage 6) ----
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""

# ---- Claude API (Stage 10) ----
ANTHROPIC_API_KEY=""
AI_MONTHLY_CAP_USD="10"

# ---- Gmail (Stage 4) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Integration tests use a separate database (wiped on every run)
TEST_DATABASE_URL="postgresql://hm:hm@localhost:5432/household_money_test"
# Playwright E2E runs the app against this database (reset + demo seed each run)
E2E_DATABASE_URL="postgresql://hm:hm@localhost:5432/household_money_e2e"
